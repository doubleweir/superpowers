#!/usr/bin/env bash
# Stop: on main, GA4 plugin builds must embed prod credentials before CWS (No.37, No.33).

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=hooks/acceptance-order-common
. "$HOOK_DIR/acceptance-order-common"

block_and_exit() {
  emit_block_json_with_meta \
    "$1" \
    "false" \
    "agent" \
    "agent_remediation_required" \
    "agent_fix_and_retry_stop_gate"
  exit 2
}

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-}"
if [ -z "$PROJECT_DIR" ]; then
  exit 0
fi

if superpowers_platform_release_active "$PROJECT_DIR"; then
  exit 0
fi

if superpowers_extension_pipeline_waived "$PROJECT_DIR"; then
  exit 0
fi

if superpowers_cws_analytics_waived "$PROJECT_DIR"; then
  exit 0
fi

if ! git -C "$PROJECT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  exit 0
fi

if [ ! -d "$PROJECT_DIR/app/plugin" ]; then
  exit 0
fi

if ! plugin_ga4_analytics_enabled "$PROJECT_DIR"; then
  exit 0
fi

CURRENT_BRANCH="$(git -C "$PROJECT_DIR" branch --show-current 2>/dev/null || true)"
if ! _is_integration_branch "$CURRENT_BRANCH"; then
  exit 0
fi

BACKGROUND_JS="$(plugin_background_js_path "$PROJECT_DIR")"
if [ ! -f "$BACKGROUND_JS" ]; then
  exit 0
fi

ENV_FILE="$(plugin_env_file_path "$PROJECT_DIR")"
if [ ! -f "$ENV_FILE" ]; then
  block_and_exit "app/plugin/.env 不存在。GA4 扩展在构建时需要 .env（WXT_GA4_MEASUREMENT_ID、WXT_GA4_API_SECRET、WXT_ANALYTICS_MODE=prod）。删除 .env 后 rebuild 会导致 analytics no-op 却仍可能上传 CWS（见 finishing Step 2.74 / No.37）。请恢复 .env → prod 模式 → npm run build → commit .output/。"
fi

MEASUREMENT_ID="$(plugin_env_get "$ENV_FILE" WXT_GA4_MEASUREMENT_ID)"
API_SECRET="$(plugin_env_get "$ENV_FILE" WXT_GA4_API_SECRET)"
ANALYTICS_MODE="$(plugin_env_get "$ENV_FILE" WXT_ANALYTICS_MODE)"

if [ -z "$MEASUREMENT_ID" ] || [ -z "$API_SECRET" ]; then
  block_and_exit "app/plugin/.env 缺少 WXT_GA4_MEASUREMENT_ID 或 WXT_GA4_API_SECRET（不能为空）。见 finishing Step 2.74 / No.37。"
fi

if [ "$ANALYTICS_MODE" != "prod" ]; then
  block_and_exit "app/plugin/.env 的 WXT_ANALYTICS_MODE 必须为 prod（当前：${ANALYTICS_MODE:-未设置}）。DebugView 验证后请改 prod 并 rebuild，不要删除 .env（见 finishing Step 2.74 / No.33）。"
fi

if ! printf '%s' "$MEASUREMENT_ID" | rg -q '^G-[A-Z0-9]+$'; then
  block_and_exit "app/plugin/.env 的 WXT_GA4_MEASUREMENT_ID 格式无效（应为 G-…）。"
fi

BG_CONTENT="$(cat "$BACKGROUND_JS")"

if ! printf '%s' "$BG_CONTENT" | rg -q 'google-analytics\.com/mp/collect'; then
  block_and_exit "app/plugin/.output/chrome-mv3/background.js 未包含 GA4 /mp/collect 端点 → analytics 可能为 no-op 构建。请用正确 .env 执行 npm run build 并 commit .output/（finishing Step 2.74 / No.37）。"
fi

if ! printf '%s' "$BG_CONTENT" | rg -qF "$MEASUREMENT_ID"; then
  block_and_exit "构建产物未嵌入 .env 中的 Measurement ID（${MEASUREMENT_ID}）。无 .env 或错误 .env 的 rebuild 会使 analytics no-op。请恢复 .env → prod → rebuild → commit .output/（finishing Step 2.74 / No.37）。"
fi

if printf '%s' "$BG_CONTENT" | rg -q 'let e=`debug`|let e=`validate`'; then
  block_and_exit "构建产物嵌入了 debug/validate analytics 模式（非 prod）。CWS 发布前须 WXT_ANALYTICS_MODE=prod 并 rebuild（finishing Step 2.74 / No.33）。"
fi

if ! printf '%s' "$BG_CONTENT" | rg -q 'let e=`prod`'; then
  block_and_exit "构建产物未检测到 prod analytics 模式。请确认 .env 为 WXT_ANALYTICS_MODE=prod 后 rebuild 并 commit .output/（finishing Step 2.74）。"
fi

exit 0
